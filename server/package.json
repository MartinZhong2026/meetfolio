{
  "name": "@meetfolio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "user:reset-password": "tsx --env-file-if-exists=../.env src/scripts/reset-password.ts",
    "test": "vitest run",
    "check:config": "tsx src/scripts/check-config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.0.0",
    "@node-rs/argon2": "^2.0.0",
    "docx": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "mammoth": "^1.8.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "proper-lockfile": "4.1.2",
    "tar-stream": "^3.1.7",
    "unbzip2-stream": "^1.4.3",
    "unpdf": "^1.9.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/tar-stream": "^3.1.5",
    "@types/unbzip2-stream": "^1.4.3",
    "@types/ws": "^8.5.0",
    "drizzle-kit": "^0.31.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.8"
  }
}
