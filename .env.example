# Copy to .env (never commit it). Everything has a safe development default except the DashScope credentials.

# --- Server ------------------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Public origin of the web app. Used for CSRF/WebSocket Origin checks and password-reset links.
# Dev (Vite):  http://localhost:5173      Production (one service serving API + web):  https://your-app.up.railway.app
APP_ORIGIN=http://localhost:5173
EXTRA_ALLOWED_ORIGINS=
DATABASE_URL=postgres://meetfolio:meetfolio@127.0.0.1:5432/meetfolio
# Set true for managed Postgres that requires TLS (Railway internal URLs usually do not).
DATABASE_SSL=false
SESSION_TTL_DAYS=30
# Private staging: only these emails / @domains may register (comma-separated). Empty = open registration.
SIGNUP_ALLOWLIST=
# auto = on when Railway variables are present; set true behind any other TLS-terminating proxy:
TRUST_PROXY=auto
LOG_LEVEL=info

# --- Alibaba Cloud Model Studio (DashScope) ----------------------------------------------------------------------
# Required for real transcription and AI summaries. Without them the app still runs; demo mode is available in dev.
DASHSCOPE_API_KEY=
# qwen-audio-* ASR models are served from a workspace-specific host: wss://{WORKSPACE_ID}.{REGION}.maas.aliyuncs.com
# Find the workspace id in the Model Studio console.
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing

# Realtime ASR provider: qwen-audio-streaming (default) | qwen3-realtime
ASR_PROVIDER=qwen-audio-streaming
# Optional native local provider: local-xasr. See docs/local-xasr.md.
# X_ASR_MODEL_DIR=
# Defaults: qwen-audio-3.0-asr-flash-streaming  |  qwen3-asr-flash-realtime  — override if your account exposes another id.
ASR_MODEL=
# Override the WebSocket endpoint entirely (international endpoints, proxies, tests).
ASR_WS_URL=
ASR_LANGUAGE_HINTS=zh,en
ASR_DOMAIN_TERMS=养老护理,认知障碍,长期照护,社区治理,访谈研究,社会工作,护理员,政策执行
# Reliability knobs (see docs/asr-integration.md)
ASR_SESSION_ROTATE_MINUTES=12
ASR_ROTATE_GRACE_SECONDS=60
ASR_MAX_RECONNECT_ATTEMPTS=8
ASR_RECONNECT_BASE_MS=500
ASR_RECONNECT_MAX_MS=15000
ASR_OUTAGE_BUFFER_SECONDS=120
ASR_RECOVERY_SPEED=2
ASR_MAX_RECOVERY_SECONDS=1800
ASR_DAILY_MINUTES_LIMIT=600

# Text generation (OpenAI-compatible endpoint). Model ids are configuration, not code.
LLM_MODEL_STANDARD=qwen3.7-plus
LLM_MODEL_QUALITY=qwen3.8-max
# Override the base URL (default: https://{WORKSPACE_ID}.{REGION}.maas.aliyuncs.com/compatible-mode/v1, or
# https://dashscope.aliyuncs.com/compatible-mode/v1 when no workspace id is set).
LLM_BASE_URL=
# Extra JSON merged into every chat request, e.g. {"enable_thinking":false}
LLM_EXTRA_BODY=
SUMMARY_SINGLE_PASS_CHAR_LIMIT=90000
SUMMARY_CHUNK_CHAR_LIMIT=24000
SUMMARY_DAILY_LIMIT=30

# --- Demo mode ---------------------------------------------------------------------------------------------------
# auto = enabled outside production. Demo meetings use synthetic transcripts and never call a paid API.
DEMO_MODE=auto

# --- File storage for uploaded reference documents ------------------------------------------------------------------
# local = development only (the Railway container filesystem is ephemeral). Use s3 in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=20

# --- Password-reset email ------------------------------------------------------------------------------------------
# smtp://user:pass@host:587  — without it, reset links are only printed to the server log in development.
SMTP_URL=
MAIL_FROM=Meetfolio <no-reply@example.com>

# --- Rate limits -----------------------------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
